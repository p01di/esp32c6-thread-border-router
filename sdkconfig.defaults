# =============================================================================
# sdkconfig.defaults — ot_br on XIAO ESP32C6 (4 MB flash, USB power only)
#
# Usage:
#   Copy this file to examples/openthread/ot_br/sdkconfig.defaults
#   (append to the existing file — do not replace it)
#
#   Then copy partitions_4mb_otbr.csv to the same folder and run:
#     idf.py set-target esp32c6
#     idf.py build flash monitor
# =============================================================================

# -----------------------------------------------------------------------------
# Flash & partition table
# -----------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb_otbr.csv"

# -----------------------------------------------------------------------------
# Wi-Fi credentials — CHANGE THESE
# -----------------------------------------------------------------------------
CONFIG_EXAMPLE_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_EXAMPLE_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"

# -----------------------------------------------------------------------------
# OpenThread — native radio (single-chip C6, no external RCP)
# -----------------------------------------------------------------------------
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# -----------------------------------------------------------------------------
# Compiler optimisations — needed to fit in 4MB
# -----------------------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_SAVE_RESTORE_LIBCALLS=y

# -----------------------------------------------------------------------------
# Logging — use INFO for debugging, WARN for production
# -----------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_WARN=y

# Newlib nano keeps printf small
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
